From 451ca335f5787c77e477041ba6ea81747208a6c9 Mon Sep 17 00:00:00 2001
From: Gianfranco Costamagna <costamagnagianfranco@yahoo.it>
Date: Fri, 31 May 2024 14:38:39 +0200
Subject: [PATCH] Fix parallel builds, depend on the created binary not on
 source files for help2man to work properly

---
 src/Makefile.am        | 2 +-
 src/server/Makefile.am | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Makefile.am b/src/Makefile.am
index a101d6a6..6669fb9a 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -106,7 +106,7 @@ endif
 endif
 
 if HELP2MAN
-psensor.1: main.c $(top_srcdir)/configure.ac
+psensor.1: psensor
 	$(MAKE) $(AM_MAKEFLAGS) psensor$(EXEEXT)
 	help2man --include=description.txt -N --name="Temperature monitoring application" --output=psensor.1 ./psensor$(EXEEXT)
 endif
diff --git a/src/server/Makefile.am b/src/server/Makefile.am
index 2812001b..bd6e1c46 100644
--- a/src/server/Makefile.am
+++ b/src/server/Makefile.am
@@ -30,7 +30,7 @@ LIBS += $(ATASMART_LIBS)
 endif
 
 if HELP2MAN
-psensor-server.1: server.c $(top_srcdir)/configure.ac
+psensor-server.1: psensor-server
 	$(MAKE) $(AM_MAKEFLAGS) psensor-server$(EXEEXT)
 	help2man --include=description.txt -N --name="Temperature and system monitoring Web server" --output=psensor-server.1 ./psensor-server$(EXEEXT)
 endif
-- 
