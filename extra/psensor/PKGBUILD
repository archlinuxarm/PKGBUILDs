pkgname=psensor
pkgver=1.2.1
pkgrel=5
pkgdesc='Graphical hardware temperature monitoring application'
arch=(x86_64)
url='https://gitlab.com/jeanfi/psensor'
license=(GPL-2.0-or-later)
depends=(
  cairo
  curl
  dconf
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  json-c
  libappindicator
  libatasmart
  libgtop
  libmicrohttpd
  libnotify
  libx11
  lm_sensors
  udisks2
)
makedepends=(
  git
  help2man
)
source=(
  "git+https://gitlab.com/jeanfi/psensor.git#tag=v$pkgver"
  psensor-fix-parallel-build.patch
  psensor.appdata.xml
)
b2sums=(
  3b110ca4bedb37d1fc3b6849265985809cba3a0d89407f0197e00757889fa6e9cc5da6c097b94b7e7f512b97b7544dcbd42f273fdece19944e8fc00a85f5cbf7
  e70b66273073f728d397c89375cb36166aedc11cb07978df1b1d2c2941065a90adebedb9e510b845f9c3e47b5f125ee62f4359c2832e2c4946565cb64cc8fb66
  5e42293f5a4dc389c35e5440ed91b08a1b0c7813f3470191f72da26c5fadca55a8f78285a1ae581ffd4724ff58f2f18e497f58269bf8f7e27b82db468ff0e3c3
)

prepare() {
  cd $pkgname

  # Fix -Werror=incompatible-pointer-types with microhttpd >= 0.9.71
  # See https://gitlab.com/jeanfi/psensor/-/merge_requests/14
  git cherry-pick -n 4088dc47dc37e1c075479505a2b190e174ad8797
  git cherry-pick -n 78f38f9ea3711bcc3cdda288d2131c3ca09eaa52
  git cherry-pick -n ad8a1e3434d3e7685a03e5b9b990d4e4fdb0e7be

  # Update dependency of manpages to fix parallel building
  # https://gitlab.com/jeanfi/psensor/-/merge_requests/31
  patch -Np1 -i ../psensor-fix-parallel-build.patch

  sed -i 's/ -Werror//' {src/lib,src/server,tests}/Makefile.am
  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
  install -Dm644 ../$pkgname.appdata.xml "$pkgdir/usr/share/metainfo/$pkgname.appdata.xml"
}
