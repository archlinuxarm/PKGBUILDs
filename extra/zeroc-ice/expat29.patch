Description: Adapt Ice 3.7 XML parser to Expat 2.9
 Use Expat's 64-bit line and column accessors when available, while retaining
 compatibility with older Expat versions.
Origin: upstream, https://github.com/zeroc-ice/ice/commit/01ff8c229b6e77807d4234c20f150967b8f199df
Forwarded: no

--- a/cpp/src/IceXML/Parser.cpp
+++ b/cpp/src/IceXML/Parser.cpp
@@ -328,6 +328,37 @@
     Handler* handler;
 };
 
+namespace
+{
+// Expat 2.9.0 deprecates the 32-bit line and column accessors in favor of
+// 64-bit variants that earlier releases don't provide.
+#if XML_MAJOR_VERSION > 2 || (XML_MAJOR_VERSION == 2 && XML_MINOR_VERSION >= 9)
+inline int
+currentLine(XML_Parser parser)
+{
+    return static_cast<int>(XML_GetCurrentLineNumber64(parser));
+}
+
+inline int
+currentColumn(XML_Parser parser)
+{
+    return static_cast<int>(XML_GetCurrentColumnNumber64(parser));
+}
+#else
+inline int
+currentLine(XML_Parser parser)
+{
+    return static_cast<int>(XML_GetCurrentLineNumber(parser));
+}
+
+inline int
+currentColumn(XML_Parser parser)
+{
+    return static_cast<int>(XML_GetCurrentColumnNumber(parser));
+}
+#endif
+}
+
