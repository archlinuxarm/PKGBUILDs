pkgname=qtractor
pkgver=1.7.0
pkgrel=1
pkgdesc="Audio/MIDI multitrack sequencer"
arch=(x86_64)
url="https://qtractor.sourceforge.io/"
license=(GPL-2.0-or-later)
groups=(pro-audio)
depends=(
  glibc
  hicolor-icon-theme
  libgcc
  libmad
  libstdc++
  libxcb
  qt6-base
  qt6-svg
  zlib
)
makedepends=(
  alsa-lib
  clap
  cmake
  dssi
  git
  jack
  ladspa
  liblo
  libogg
  libsamplerate
  libsndfile
  libvorbis
  lilv
  lv2
  qt6-tools
  rubberband
  suil
  vst3sdk
)
optdepends=(
  'new-session-manager: for session management'
)
provides=(
  clap-host
  dssi-host
  ladspa-host
  lv2-host
  vst-host
  vst3-host
)
source=(
  $pkgname::git+https://github.com/rncbc/qtractor.git#tag=v$pkgver
  minibpm::git+https://github.com/breakfastquay/minibpm.git
)
sha512sums=('9989b7bfa63c8c9d0c74536ae6246741eeed6c93ab064aef87a9cb28d8e6f8b83019aa5f70728ec74ddcc5c8c9d265c2e81f169ae97e29788358a421e8f93e0a'
            'SKIP')
b2sums=('f5fe392640d0ff99a1d760ccd2a42c3e57418dc1ee92f6c2b39b5f71fbc9f4d94e5f39a7047ee6896e39b44cd6522013f444f82f215b87a357f06cacc4b597e7'
        'SKIP')

prepare() {
  cd $pkgname
  git submodule init
  git config submodule.src/minibpm.url "$srcdir/minibpm"
  git submodule deinit src/clap
  git submodule deinit src/vst3/base
  git submodule deinit src/vst3/pluginterfaces
  git submodule deinit src/vst3/public.sdk
  git -c protocol.file.allow=always submodule update

  # symlink vst3sdk into place
  rm -frv src/vst3
  ln -fsv /usr/src/vst3sdk/ src/vst3
}

build() {
  local cmake_options=(
    -B build
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CONFIG_QT6=ON
    -D CONFIG_SSE=OFF
    -D CONFIG_LV2_UI_GTK2=OFF
    -D CONFIG_LV2_UI_GTKMM2=OFF
    -S $pkgname
    -W no-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build --verbose
}

package() {
  depends+=(
    alsa-lib libasound.so
    jack libjack.so
    liblo liblo.so
    libogg libogg.so
    libsamplerate libsamplerate.so
    libsndfile libsndfile.so
    libvorbis libvorbisenc.so libvorbisfile.so libvorbis.so
    lilv liblilv-0.so
    rubberband librubberband.so
  )

  DESTDIR="$pkgdir" cmake --install build
  install -vDm 644 $pkgname/README* -t "$pkgdir/usr/share/doc/$pkgname/"
}
