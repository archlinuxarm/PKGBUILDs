# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: Morten Linderud <foxboron@archlinux.org>
# Contributor: Christian Brauner <christianvanbrauner@gmail.com>

# ALARM: Kevin Mihelich <kevin@archlinuxarm.org>
#  - add -D_FILE_OFFSET_BITS=64 to CPPFLAGS

pkgname=lxcfs
pkgver=7.0.0
pkgrel=2
pkgdesc="FUSE filesystem for LXC"
arch=(x86_64)
url="https://linuxcontainers.org/"
license=('LGPL-2.1-or-later')
depends=('lxc' 'libnih' 'fuse3' 'dbus-glib')
makedepends=('help2man' 'meson' 'python-jinja' 'systemd' 'git')
options=('emptydirs')
source=("git+https://github.com/lxc/lxcfs.git#tag=v$pkgver?signed")
validpgpkeys=('602F567663E593BCBD14F338C638974D64792D67')
sha256sums=('0dfc110511dd5f08809cdf2324c3ebdd2c8f199c3ca38572cbf0d43faabd3182')

build() {
    cd "$pkgname"
    CPPFLAGS+=" -D_FILE_OFFSET_BITS=64"
    arch-meson ../build
    meson compile -C ../build
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" meson install -C ../build
    install -dm0755 "$pkgdir"/var/lib/lxcfs
}
