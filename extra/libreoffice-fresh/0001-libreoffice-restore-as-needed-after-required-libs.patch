From: Andy
Subject: [PATCH] gbuild: restore --as-needed after retained libraries

The dynamic-link rule disables --as-needed for explicitly listed LibreOffice
libraries. Restore it after that list so the C++ driver's implicit runtime
libraries are retained only when needed. Limit the linker option to Linux.

--- a/solenv/gbuild/platform/unxgcc.mk
+++ b/solenv/gbuild/platform/unxgcc.mk
@@ -169,6 +169,7 @@
 		    -Wl$(COMMA)--end-group \
 		    -Wl$(COMMA)--no-as-needed \
 		    $(patsubst lib%.a,-l%,$(patsubst lib%.so,-l%,$(patsubst %.$(gb_Library_UDK_MAJORVER),%,$(foreach lib,$(LINKED_LIBS),$(call gb_Library_get_filename,$(lib)))))) \
+		    $(if $(filter LINUX,$(OS)),-Wl$(COMMA)--as-needed) \
                 ) \
 		-o $(1) \
 	$(if $(SOVERSIONSCRIPT),&& ln -sf ../../program/$(notdir $(1)) $(ILIBTARGET)) \
