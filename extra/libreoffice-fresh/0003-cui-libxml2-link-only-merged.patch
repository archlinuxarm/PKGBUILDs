--- a/RepositoryExternal.mk
+++ b/RepositoryExternal.mk
@@ -1020,4 +1020,16 @@
 endif # SYSTEM_LIBXML
 
+# Some libraries (for example cui) are merged into libmergedlo. Keep the
+# libxml2 compile settings on the original library, while linking libxml2 only
+# into the merged library where the code is finally linked.
+define gb_LinkTarget__use_libxml2_headers
+$(if $(SYSTEM_LIBXML),$(call gb_LinkTarget_add_defs,$(1),-DSYSTEM_LIBXML))
+$(call gb_LinkTarget_set_include,$(1),\
+	$$(INCLUDE) \
+	$(LIBXML_CFLAGS) \
+)
+
+endef
+
 
 ifneq ($(SYSTEM_LIBXSLT),)
--- a/cui/Library_cui.mk
+++ b/cui/Library_cui.mk
@@ -71,11 +71,16 @@
-$(eval $(call gb_Library_use_externals,cui,\
-	boost_headers \
-	$(call gb_Helper_optional,OPENCL,\
-		clew) \
-    icuuc \
-    icu_headers \
-    libxml2 \
-    orcus-parser \
-    orcus \
-    zxing \
-))
+$(eval $(call gb_Library_use_externals,cui,libxml2_headers))
+
+# cui is merged into libmergedlo; the external library belongs to that final
+# link target, not to the intermediate libcuilo.so.
+$(eval $(call gb_LinkTarget_use_external,$(call gb_Library_get_linktarget,merged),libxml2))
+
+$(eval $(call gb_Library_use_externals,cui,\
+	boost_headers \
+	$(call gb_Helper_optional,OPENCL,\
+		clew) \
+    icuuc \
+    icu_headers \
+    orcus-parser \
+    orcus \
+    zxing \
+))
