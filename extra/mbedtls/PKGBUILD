# ALARM: Kevin Mihelich <kevin@archlinuxarm.org>
#  - patch to fix FTBFS with gcc 14: https://github.com/Mbed-TLS/mbedtls/issues/9003

pkgname=mbedtls
pkgver=4.1.0
pkgrel=1
pkgdesc='An open source, portable, easy to use, readable and flexible TLS library'
arch=(x86_64)
url=https://tls.mbed.org
license=(Apache-2.0)
depends=(
  glibc
  sh
)
checkdepends=(python)
makedepends=(
  cmake
  git
  ninja
  python
  python-jinja
  python-jsonschema
)
provides=(
  libmbedcrypto.so
  libmbedtls.so
  libmbedx509.so
  libtfpsacrypto.so
  polarssl
)
replaces=(polarssl)
conflicts=(polarssl)
options=(staticlibs)
source=(
  git+https://github.com/Mbed-TLS/mbedtls.git#tag=v${pkgver}
  git+https://github.com/Mbed-TLS/mbedtls-framework.git
  git+https://github.com/Mbed-TLS/TF-PSA-Crypto.git
  gcc14.patch
)
b2sums=('7fd7a15dfece3007f5c1e4ae34f1832cba2f0367e73478f99f2d0b0de363692874a178cb008c178eaad714e5ea82a8f29e85fa904662f8af432ff0733f40081c'
        'SKIP'
        'SKIP'
        '1e399241d0366d1ce374e4978f350e6b5a0b453ac151f75d1daa3b74a3394db10e7818ce8617e8c027e99982d3dfc357ef34330d1461e641dff4263db67a3150')

prepare() {
  cp -r mbedtls-framework mbedtls-framework-tf-psa-crypto
  cd mbedtls
  git submodule init framework
  git config submodule.framework.url "${srcdir}"/mbedtls-framework
  git -c protocol.file.allow=always submodule update framework
  git submodule init tf-psa-crypto
  git config submodule.tf-psa-crypto.url "${srcdir}"/TF-PSA-Crypto
  git -c protocol.file.allow=always submodule update tf-psa-crypto
  cd tf-psa-crypto
  git submodule init framework
  git config submodule.framework.url "${srcdir}"/mbedtls-framework-tf-psa-crypto
  git -c protocol.file.allow=always submodule update framework
  patch -p1 -i "${srcdir}"/gcc14.patch
}

build() {
  export CFLAGS+=' -ffat-lto-objects'
  cmake -S mbedtls -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_SKIP_RPATH=ON \
    -DUSE_SHARED_MBEDTLS_LIBRARY=ON \
    -DUSE_STATIC_MBEDTLS_LIBRARY=ON \
    -Wno-dev
  cmake --build build
}

check() {
  LD_LIBRARY_PATH="${srcdir}"/build/library ctest --test-dir build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  # rename generic utils
  local _prog _baseprog
  for _prog in "${pkgdir}"/usr/bin/*; do
  _baseprog=$(basename "$_prog")
    mv -v "$_prog" "${_prog//$_baseprog/mbedtls_$_baseprog}"
  done

  # fixup static lib permissions
  chmod 644 "$pkgdir"/usr/lib/*.a
}

