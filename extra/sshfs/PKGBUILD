#  - use -D_FILE_OFFSET_BITS=64 with 32-bit ARM

pkgname=sshfs
pkgver=3.7.7
pkgrel=1
pkgdesc="FUSE client based on the SSH File Transfer Protocol"
arch=(x86_64)
url="https://github.com/libfuse/sshfs"
license=(GPL-2.0-or-later)
depends=(
  fuse3
  glib2
  glibc
  openssh
)
makedepends=(
  meson
  python-docutils
)
source=(https://github.com/libfuse/sshfs/releases/download/$pkgname-$pkgver/$pkgname-$pkgver.tar.xz{,.asc})
b2sums=('982445ed8ac7ad67a141dca5e6f5499f45627cfa7454e8fe5b94736b47a65af5d2f3f91fa0ccb293e047d7f39327123c890f4694c0cff391119f648c22999073'
        'SKIP')
validpgpkeys=(
  '9C113099DF707BD240A192D4C6E054D074D5DD2B' # Haoxi Tan <h4sh5@pm.me>
  'D7DC77E309C316239A83BF89C1FD89D2B4811220' # Abhinav Agarwal <abhinavagarwal1996@gmail.com>
)

build() {
  [[ $CARCH == 'arm' || $CARCH == 'armv6h' || $CARCH == 'armv7h' ]] && export CFLAGS+=" -D_FILE_OFFSET_BITS=64"
  arch-meson $pkgname-$pkgver build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
