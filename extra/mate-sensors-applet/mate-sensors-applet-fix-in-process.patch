+++ b/plugins/acpi/acpi-plugin.c
@@ -23,7 +23,7 @@
 
 #include <stdio.h>
 #include <glib.h>
-#include <glib/gi18n.h>
+#include <glib/gi18n-lib.h>
 #include "acpi-plugin.h"
 
 const gchar *plugin_name = "acpi";
