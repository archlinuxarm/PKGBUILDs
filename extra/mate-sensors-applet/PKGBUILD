# Maintainer: Alexander Epaneshnikov <alex19ep@archlinux.org>
# Contributor: Brad Fanella <cesura@archlinux.org>
# Contributor: Martin Wimpress <code@flexion.org>

# ALARM: Kevin Mihelich <kevin@archlinuxarm.org>
#  - drop dependency on libxnvctrl (nvidia-settings)

pkgname=mate-sensors-applet
pkgver=1.28.0
pkgrel=5
pkgdesc="A MATE Panel applet to display readings from hardware sensors, including CPU temperature, fan speeds and voltage readings"
arch=(x86_64)
url='https://github.com/mate-desktop/mate-sensors-applet'
license=(GPL-2.0-or-later)
depends=(
  cairo
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gtk3
  hicolor-icon-theme
  libnotify
  libx11
  lm_sensors
  mate-panel
)
makedepends=(
  docbook-xsl
  git
  mate-common
  yelp-tools
)
optdepends=(
  'hddtemp: get HDD temperatures'
  'udisks2: get HDD temperatures'
)
groups=(mate-extra)
source=("git+https://github.com/mate-desktop/mate-sensors-applet.git#tag=v$pkgver")
b2sums=(26e67062020673ada31c6c8c4516b342e9856cc4493c85f78eb390f35d72964bf059cf60f9066c5ef040d9afe6131d601b447db65b3bcd74d2eae1de26d964d6)

prepare() {
  cd $pkgname

  # Fix an invalid pointer crash with glib 2.83.2
  # https://github.com/mate-desktop/mate-sensors-applet/pull/137
  git cherry-pick -n 9b74dc16d852a40d37f7ce6c236406959fd013e5

  autoreconf -fiv
}

build() {
  cd $pkgname
  ./configure \
    --prefix=/usr \
    --libexec="/usr/lib/$pkgname" \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-in-process
  make
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install
}
