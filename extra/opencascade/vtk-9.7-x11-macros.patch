+  // Include VTK's X11 headers before GL/glx.h and before undef'ing the X11
+  // macros. VTK <= 9.6 needs Xlib's `#define Status int` removed before
+  // vtksys::Status is declared, while VTK >= 9.7 uses `typedef Status` in
+  // vtkX11Functions.h and thus needs the macro defined. Letting VTK pull in
+  // <X11/Xlib.h> itself, in the right order, satisfies both.
+  #include <vtkXRenderWindowInteractor.h>
+  #include <vtkXOpenGLRenderWindow.h>
+
   #include <GL/glx.h>
 
   // Preventing naming collisions between
