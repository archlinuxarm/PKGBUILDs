highmem=1

pkgname=mesa-amber
pkgver=21.3.9
pkgrel=8
pkgdesc="classic OpenGL (non-Gallium3D) drivers"
url="https://www.mesa3d.org/"
arch=('x86_64')
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
makedepends=(
  'cmake'
  'elfutils'
  'libdrm'
  'libglvnd'
  'libunwind'
  'libx11'
  'libxdamage'
  'libxml2'
  'libxrandr'
  'libxshmfence'
  'libxxf86vm'
  'meson'
  'python-mako'
  'python-packaging'
  'valgrind'
  'wayland'
  'wayland-protocols'
  'xorgproto'
  'zstd'
)
source=(
  https://archive.mesa3d.org/older-versions/21.x/mesa-${pkgver}.tar.xz{,.sig}
  mesa-amber-21.3.9-meson-Support-for-both-packaging-and-distutils.patch
  mesa-amber-21.3.9-C23-glibc-threads.patch
)
sha256sums=('91fe6f20339884e37a7c47bfba42fb1cd397512c9ed5ad423de369f047cd8b5c'
            'SKIP'
            '578976a7a8a92fb73843fa5c495342c7bdb1c9ddd57a28b6f2f8aea6b156612b'
