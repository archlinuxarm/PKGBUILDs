# Contributor: Diab Neiroukh <lazerl0rd@thezest.dev>

# ALARM: SandaruKasa <sandarukasa plus archarm at ya dot ru>
#  - set `MI_NO_OPT_ARCH` to fix https://github.com/microsoft/mimalloc/issues/1095

pkgname=mimalloc
pkgver=3.4.5
pkgrel=1
pkgdesc='General-purpose allocator with excellent performance characteristics'
arch=(x86_64)
url='https://github.com/microsoft/mimalloc'
license=(MIT)
depends=(glibc)
makedepends=(git cmake ninja)
options=(staticlibs)
source=("$pkgname::git+$url#tag=v$pkgver")
sha512sums=('8986022bb628e4c309b36b85b25698cc1e23b5ac5a069d9bfd269c62b207eb94d931790d1e4e601821812c4e36c2793cec5c7b58745f6ba5487a197db9868bc7')
b2sums=('dc631e76ebc3eb64eb9098f586fd9d9cd621163995fe3963430e2ea9102f629d9f82669b57c2d5df3dffa87851de63f83f2dd5c4dd6cbf3d99f995c37bfeb257')

build() {
  local cmake_options=(
    -B build
    -S "$pkgname"
    -G Ninja
    -W no-dev
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -D MI_BUILD_OBJECT=OFF
    -D MI_INSTALL_TOPLEVEL=ON
    -D MI_NO_OPT_ARCH=ON
  )

  cmake "${cmake_options[@]}"

  cmake --build build
}

check() {
  cd build

  ctest --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # license
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$pkgname/LICENSE"
}
