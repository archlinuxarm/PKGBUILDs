From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Jan Alexander Steffens (heftig)" <heftig@archlinux.org>
Date: Wed, 18 Nov 2026 22:07:40 +0100
Subject: [PATCH] panfrost: Fix types of panfrost_vdrm functions

The size parameter has to be uint64_t, not size_t.

Signed-off-by: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
---
 src/panfrost/lib/kmod/panfrost_kmod.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/lib/kmod/panfrost_kmod.c b/src/panfrost/lib/kmod/panfrost_kmod.c
index 9b7010db481c..8680d161fa22 100644
--- a/src/panfrost/lib/kmod/panfrost_kmod.c
+++ b/src/panfrost/lib/kmod/panfrost_kmod.c
@@ -1238,7 +1238,7 @@ syncobjs_alloc_error:
 }
 
 static struct pan_kmod_bo *
-panfrost_vdrm_bo_import(struct pan_kmod_dev *dev, uint32_t handle, size_t size)
+panfrost_vdrm_bo_import(struct pan_kmod_dev *dev, uint32_t handle, uint64_t size)
 {
    struct panfrost_vdrm_device *pan_vdrm = pan_dev_to_vdrm_dev(dev);
    struct panfrost_ccmd_get_bo_offset_rsp *rsp;
@@ -1300,7 +1300,7 @@ panfrost_vdrm_bo_free(struct pan_kmod_bo *bo)
 
 static struct pan_kmod_bo *
 panfrost_vdrm_bo_alloc(struct pan_kmod_dev *dev,
-                       struct pan_kmod_vm *exclusive_vm, size_t size,
+                       struct pan_kmod_vm *exclusive_vm, uint64_t size,
                        uint32_t flags)
 {
    struct panfrost_vdrm_device *pan_vdrm = pan_dev_to_vdrm_dev(dev);
