From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Jan Alexander Steffens (heftig)" <heftig@archlinux.org>
Date: Fri, 20 Nov 2026 08:31:13 +0100
Subject: [PATCH] Revert "mesa: don't advertise APIs that are not built"

This reverts commit 338afb32f868e8607e7f082381dc859dae5583e8.

For: https://gitlab.freedesktop.org/mesa/mesa/-/work_items/16934
---
 src/mesa/main/version.c | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/src/mesa/main/version.c b/src/mesa/main/version.c
index 2747083f1baa..ec4848f7173e 100644
--- a/src/mesa/main/version.c
+++ b/src/mesa/main/version.c
@@ -573,27 +573,19 @@ _mesa_get_version(const struct gl_extensions *extensions,
                   struct gl_constants *consts, gl_api api)
 {
    switch (api) {
-#if HAVE_OPENGL
    case API_OPENGL_COMPAT:
       /* Disable higher GLSL versions for legacy contexts.
        * This disallows creation of higher compatibility contexts. */
       if (!consts->AllowHigherCompatVersion) {
          consts->GLSLVersion = consts->GLSLVersionCompat;
       }
       FALLTHROUGH;
    case API_OPENGL_CORE:
       return compute_version(extensions, consts, api);
-#endif
-#if HAVE_OPENGL_ES_1
    case API_OPENGLES:
       return 11;
-#endif
-#if HAVE_OPENGL_ES_2
    case API_OPENGLES2:
       return compute_version_es2(extensions, consts);
-#endif
-   default:
-      break;
    }
    return 0;
 }
