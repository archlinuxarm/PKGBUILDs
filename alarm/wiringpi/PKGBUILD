# Maintainer: Kevin Mihelich <kevin@archlinuxarm.org>
# Contributor: Mike Brown <mbrown@archlinuxarm.org>

pkgname=wiringpi
_pkgname=WiringPi
epoch=1
pkgver=3.19
pkgrel=1
pkgdesc='GPIO Interface library for the Raspberry Pi'
arch=(armv7h aarch64)
license=(LGPL-3.0-or-later)
url='https://github.com/WiringPi/WiringPi'
source=("$pkgname-$pkgver.tar.gz::https://github.com/$_pkgname/$_pkgname/archive/refs/tags/v$pkgver.tar.gz")
md5sums=('5a952a1396be307494067168610fa612')

prepare() {
  cd $_pkgname-$pkgver
  sed -i 's|/usr/local/bin/gpio|/usr/bin/gpio|' wiringPi/wiringPi.c
}

build() {
  cd $_pkgname-$pkgver

  make -C wiringPi all
  make -C devLib all INCLUDE+="-I$srcdir/$_pkgname-$pkgver/wiringPi"

  ln -sf "$srcdir/$_pkgname-$pkgver/wiringPi/libwiringPi.so.$pkgver" wiringPi/libwiringPi.so
  ln -sf "$srcdir/$_pkgname-$pkgver/devLib/libwiringPiDev.so.$pkgver" devLib/libwiringPiDev.so
  make -C gpio INCLUDE+="-I$srcdir/$_pkgname-$pkgver/wiringPi -I$srcdir/$_pkgname-$pkgver/devLib" LDFLAGS+="-L$srcdir/$_pkgname-$pkgver/wiringPi -L$srcdir/$_pkgname-$pkgver/devLib"
  make -C wiringPiD INCLUDE+="-I$srcdir/$_pkgname-$pkgver/wiringPi -I$srcdir/$_pkgname-$pkgver/devLib" LDFLAGS+="-L$srcdir/$_pkgname-$pkgver/wiringPi -L$srcdir/$_pkgname-$pkgver/devLib"
}

package(){
  cd $_pkgname-$pkgver

  make LDCONFIG= PREFIX= DESTDIR="${pkgdir}/usr" -C wiringPi install
  make LDCONFIG= PREFIX= DESTDIR="${pkgdir}/usr" -C devLib install
  install -d "${pkgdir}/usr/bin"
  make PREFIX= DESTDIR="${pkgdir}/usr" WIRINGPI_SUID=1 -C gpio install
  install -m0755 wiringPiD/wiringpid "${pkgdir}/usr/bin"
  install -Dm644 COPYING.LESSER "$pkgdir/usr/share/licenses/$pkgname/COPYING.LESSER"
}
